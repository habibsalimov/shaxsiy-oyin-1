{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shaxsiy-oyin",
  "account_id": "61aa0f87e7ee0ea6c5387a017e7e430a",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/ws"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shaxsiy-oyin-results",
      "database_id": "c0f4f121-b932-41ff-a136-bdc2bd80f639",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "shaxsiy.turnirlar.uz",
      "custom_domain": true
    }
  ]
}
